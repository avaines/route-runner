{
  "name": "@route-runner/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/index.js && node scripts-package.cjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "dev": "node --import tsx src/dev.ts",
    "dev:live": "node --env-file=.env.local --import tsx src/dev.ts --live",
    "spike": "node --import tsx src/spike.ts"
  },
  "dependencies": {
    "@route-runner/contracts": "file:../../packages/contracts",
    "@aws-sdk/client-ssm": "3.1146.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
