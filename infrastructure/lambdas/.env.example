# Copy this file to .env.local in this folder and fill in your openrouteservice key.
# Backend only: never put this key in the frontend folder or a VITE_ variable.
ORS_API_KEY=

# Set to yes only when intentionally running the live provider experiment.
ALLOW_LIVE_PROVIDER=no

# npm run dev stays synthetic. npm run dev:live loads .env.local and requires
# ALLOW_LIVE_PROVIDER=yes; every generation consumes provider quota.
# To load this file for the
# live experiment, run from this folder with a request JSON file on stdin:
# node --env-file=.env.local --import tsx src/spike.ts < request.json
# Deployed Lambda uses SSM SecureString via ROUTING_PARAMETER_NAME instead.
