# Copy this file to .env.local in this folder and fill in your Google key.
# Enable Maps JavaScript API (not Maps Embed API or Routes API).
# Public browser key only; restrict by website referrers and Maps JavaScript API.
# Restart the dev server after editing; production previews require a rebuild.
VITE_GOOGLE_MAPS_API_KEY=
# Explicit synthetic demo; never enable for release builds.
VITE_MOCK_API=false
# Development proxy only. Backend npm run dev uses port 3001.
VITE_API_PROXY_TARGET=http://localhost:3001
