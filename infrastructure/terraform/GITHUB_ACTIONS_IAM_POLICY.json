{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ManageTerraformState",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": "arn:aws:s3:::terraform-804221019544-state/route-runner/*"
        },
        {
            "Sid": "ListTerraformState",
            "Effect": "Allow",
            "Action": [
                "s3:GetBucketLocation",
                "s3:ListBucket"
            ],
            "Resource": "arn:aws:s3:::terraform-804221019544-state"
        },
        {
            "Sid": "ManageRouteRunnerBuckets",
            "Effect": "Allow",
            "Action": [
                "s3:*"
            ],
            "Resource": [
                "arn:aws:s3:::804221019544-us-east-1-*-route-runner",
                "arn:aws:s3:::804221019544-us-east-1-*-route-runner/*",
                "arn:aws:s3:::804221019544-us-east-1-*-route-runner-*",
                "arn:aws:s3:::804221019544-us-east-1-*-route-runner-*/*"
            ]
        },
        {
            "Sid": "ReadS3Metadata",
            "Effect": "Allow",
            "Action": [
                "s3:GetAccountPublicAccessBlock",
                "s3:ListAllMyBuckets"
            ],
            "Resource": "*"
        },
        {
            "Sid": "ManageRouteRunnerRoles",
            "Effect": "Allow",
            "Action": [
                "iam:CreateRole",
                "iam:DeleteRole",
                "iam:DeleteRolePolicy",
                "iam:GetRole",
                "iam:GetRolePolicy",
                "iam:ListAttachedRolePolicies",
                "iam:ListInstanceProfilesForRole",
                "iam:ListRolePolicies",
                "iam:ListRoleTags",
                "iam:PassRole",
                "iam:PutRolePolicy",
                "iam:TagRole",
                "iam:UntagRole",
                "iam:UpdateAssumeRolePolicy"
            ],
            "Resource": [
                "arn:aws:iam::804221019544:role/*-us-east-1-route-runner-*",
                "arn:aws:iam::804221019544:role/804221019544-us-east-1-*-route-runner-*"
            ]
        },
        {
            "Sid": "CreateServiceLinkedRoles",
            "Effect": "Allow",
            "Action": "iam:CreateServiceLinkedRole",
            "Resource": "arn:aws:iam::*:role/aws-service-role/*",
            "Condition": {
                "StringLike": {
                    "iam:AWSServiceName": [
                        "cloudfront.amazonaws.com",
                        "lambda.amazonaws.com",
                        "replicator.lambda.amazonaws.com"
                    ]
                }
            }
        },
        {
            "Sid": "ManageRouteRunnerLambdas",
            "Effect": "Allow",
            "Action": [
                "lambda:AddPermission",
                "lambda:CreateFunction",
                "lambda:CreateFunctionUrlConfig",
                "lambda:DeleteFunction",
                "lambda:DeleteFunctionUrlConfig",
                "lambda:DisableReplication*",
                "lambda:EnableReplication*",
                "lambda:Get*",
                "lambda:List*",
                "lambda:PublishVersion",
                "lambda:RemovePermission",
                "lambda:TagResource",
                "lambda:UntagResource",
                "lambda:UpdateFunctionCode",
                "lambda:UpdateFunctionConfiguration",
                "lambda:UpdateFunctionUrlConfig"
            ],
            "Resource": "arn:aws:lambda:us-east-1:804221019544:function:*route-runner-*"
        },
        {
            "Sid": "ManageRouteRunnerCloudFront",
            "Effect": "Allow",
            "Action": [
                "cloudfront:*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "ManageRouteRunnerAlarms",
            "Effect": "Allow",
            "Action": [
                "cloudwatch:DescribeAlarms",
                "cloudwatch:PutMetricAlarm",
                "cloudwatch:DeleteAlarms",
                "cloudwatch:ListTagsForResource",
                "cloudwatch:TagResource",
                "cloudwatch:UntagResource"
            ],
            "Resource": "arn:aws:cloudwatch:us-east-1:804221019544:alarm:*-us-east-1-route-runner-*"
        },
        {
            "Sid": "ManageRouteRunnerAlertTopics",
            "Effect": "Allow",
            "Action": [
                "sns:CreateTopic",
                "sns:DeleteTopic",
                "sns:GetTopicAttributes",
                "sns:ListTagsForResource",
                "sns:SetTopicAttributes",
                "sns:TagResource",
                "sns:UntagResource"
            ],
            "Resource": [
                "arn:aws:sns:us-east-1:804221019544:*-us-east-1-route-runner-alerts"
            ]
        },
        {
            "Sid": "ManageCertificatesAndDns",
            "Effect": "Allow",
            "Action": [
                "acm:*",
                "route53:Get*",
                "route53:List*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "ManageRouteRunnerDnsRecords",
            "Effect": "Allow",
            "Action": "route53:ChangeResourceRecordSets",
            "Resource": "arn:aws:route53:::hostedzone/Z02513943OI8D0F4XM1MJ"
        },
        {
            "Sid": "ManageRouteRunnerLogs",
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogGroup",
                "logs:DeleteLogGroup",
                "logs:DeleteRetentionPolicy",
                "logs:DescribeLogGroups",
                "logs:ListTagsForResource",
                "logs:PutRetentionPolicy",
                "logs:TagResource",
                "logs:UntagResource"
            ],
            "Resource": "*"
        },
        {
            "Sid": "ReadIdentityAndTags",
            "Effect": "Allow",
            "Action": [
                "sts:GetCallerIdentity",
                "tag:GetResources"
            ],
            "Resource": "*"
        },
        {
            "Sid": "DescribeApplicationParameters",
            "Effect": "Allow",
            "Action": "ssm:DescribeParameters",
            "Resource": "*"
        },
        {
            "Sid": "ManageApplicationParameters",
            "Effect": "Allow",
            "Action": [
                "ssm:PutParameter",
                "ssm:GetParameter",
                "ssm:DeleteParameter",
                "ssm:AddTagsToResource",
                "ssm:RemoveTagsFromResource",
                "ssm:ListTagsForResource"
            ],
            "Resource": [
                "arn:aws:ssm:us-east-1:804221019544:parameter/*-us-east-1-route-runner/*"
            ]
        }
    ]
}
